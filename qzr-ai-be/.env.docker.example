DATABASE_URL=postgresql://postgres:jacopoqzr@postgres:5432/qzr_ai
PORT=8555
CORS_ORIGIN=http://localhost:3000

CSV_SOURCE_DIR=/app/data
CSV_ROWS_PER_CHUNK=5
PDF_SOURCE_DIR=/app/data
UPLOAD_SOURCE_DIR=/app/uploads
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
DEBUG_INDEX_CHUNKS=false
DEBUG_INDEX_CHUNK_LIMIT=5
DEBUG_INDEX_CHARS=1600
DEBUG_INDEX_OUTPUT_DIR=/app/uploads/debug
EMBEDDING_BATCH_SIZE=16

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_QUERY_REWRITE_MODEL=
OLLAMA_CONVERSATION_MEMORY_MODEL=
OLLAMA_EMBED_TIMEOUT_MS=20000
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_MAX_OUTPUT_TOKENS=4096
QUERY_REWRITE_TIMEOUT_MS=15000
QUERY_REWRITE_MAX_TOKENS=300
QUERY_REWRITE_RECENT_MESSAGES=8
DEBUG_QUERY_REWRITE=false
CONVERSATION_MEMORY_TIMEOUT_MS=30000
CONVERSATION_MEMORY_MAX_TOKENS=500
CONVERSATION_MEMORY_RECENT_MESSAGES=4
CONVERSATION_MEMORY_FALLBACK_MESSAGES=8
DEBUG_CONVERSATION_MEMORY=false

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=csv_documents
QDRANT_SEARCH_LIMIT=12
QDRANT_SCORE_THRESHOLD=0.2
MIN_TOP_DOCUMENT_SCORE=0.42
MIN_DOCUMENT_SCORE=0.25
MIN_RELATIVE_SCORE_RATIO=0.82
MAX_CONTEXT_DOCUMENTS=8
QDRANT_TIMEOUT_MS=3000
QDRANT_FALLBACK_QUERY_HINT=QZR
QDRANT_FALLBACK_MIN_TOP_SCORE=0.42
DEBUG_RAG=false
DEBUG_RAG_TEXT_CHARS=300
DEBUG_RAG_PROMPT=false
DEBUG_RAG_PROMPT_CHARS=2000
