DATABASE_URL=postgresql://postgres:jacopoqzr@postgres:5432/qzr_ai
PORT=8555
CORS_ORIGIN=http://localhost:3000

CSV_SOURCE_DIR=/app/data
CSV_ROWS_PER_CHUNK=5
PDF_SOURCE_DIR=/app/data
UPLOAD_SOURCE_DIR=/app/uploads
PDF_CHUNK_SIZE=1200
PDF_CHUNK_OVERLAP=200
DEBUG_INDEX_CHUNKS=false
DEBUG_INDEX_CHUNK_LIMIT=5
DEBUG_INDEX_CHARS=1600
DEBUG_INDEX_OUTPUT_DIR=/app/uploads/debug
EMBEDDING_BATCH_SIZE=16

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_EMBED_TIMEOUT_MS=20000
OLLAMA_CONTEXT_SIZE=16384
OLLAMA_MAX_OUTPUT_TOKENS=4096

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=csv_documents
QDRANT_SEARCH_LIMIT=8
QDRANT_SCORE_THRESHOLD=0.35
MIN_DOCUMENT_RELEVANCE_SCORE=0.35
QDRANT_TIMEOUT_MS=3000
QDRANT_FALLBACK_QUERY_HINT=QZR
